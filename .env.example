# Copie este arquivo para .env e preencha com os seus valores.
# NUNCA commite o arquivo .env — ele contem segredos.

# Banco de dados Turso (https://turso.tech)
TURSO_CONNECTION_URL=libsql://seu-banco.turso.io
TURSO_AUTH_TOKEN=

# Segredo de assinatura das sessoes.
# Gere um novo com: openssl rand -base64 32
BETTER_AUTH_SECRET=

# URL publica do site. Em producao use o dominio real, ex: https://cashview.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# APIs de cotacoes (opcionais - as telas de mercado usam se preenchidas)
FINNHUB_API_KEY=
COINGECKO_API_KEY=
